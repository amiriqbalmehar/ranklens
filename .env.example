# Firebase web app config — copy from the Firebase console
# (Project settings > Your apps > Web app). See firebase-setup.md.
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# App Check (required by Firebase AI Logic).
# For local development, set this to true and register the debug token
# printed in the browser console in the Firebase console
# (Security > App Check > Apps > Manage debug tokens).
VITE_APPCHECK_DEBUG=true

# reCAPTCHA v3 site key for App Check in production.
# Leave empty for local development with the debug token.
VITE_RECAPTCHA_V3_SITE_KEY=
